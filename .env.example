# Server Configuration
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-url.vercel.app
CLIENT_URL=https://your-frontend-url.vercel.app
PORT=7000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT
JWT_SECRET=your-jwt-secret-key-here
LOG_LEVEL=info

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Raddazle
EMAIL_FROM=no-reply@raddazle.com
SUPPORT_EMAIL=support@raddazle.com

# Payment Gateways
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
FLW_SECRET_KEY=your_flutterwave_secret_key
FLW_SECRET_HASH=your_flutterwave_webhook_hash
BANK_ACCOUNT_NAME=Your Business Name
BANK_ACCOUNT_NUMBER=1234567890
BANK_BANK_NAME=Your Bank Name
BANK_TRANSFER_INSTRUCTIONS=Use your Order ID as payment reference.

# OpenAI Chatbot
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
CHAT_SYSTEM_PROMPT=You are Raddazle's helpful customer care assistant.
CHATBOT_RATE_LIMIT_MAX=20
CHATBOT_RATE_LIMIT_WINDOW_MS=60000

# Payment Reconciliation
PAYMENT_RECON_INTERVAL_MS=300000
PAYMENT_RECON_MIN_AGE_MS=120000
PAYMENT_RECON_FAIL_AFTER_MS=86400000

# Super Admin (for initial setup only)
SUPER_ADMIN_EMAIL=admin@raddazle.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Admin
SUPER_ADMIN_RESET=false
